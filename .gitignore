# PocketOps .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/

# Environment and secrets
.env
.env.*
*.key
*.pem
*-credentials.json
service-account*.json
secrets/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Run outputs (may contain sensitive data)
runs/current/*.yaml
runs/current/*.json
runs/current/*.md
runs/archive/*/*.yaml
runs/archive/*/*.json
runs/archive/*/*.md
!runs/current/.gitkeep
!runs/archive/.gitkeep
runs/current/evidence/
runs/archive/*/evidence/

# Local data exports
exports/
banking-exports/
banking-reports/

# Local configuration (keep examples)
config/environments/*.yaml
!config/environments/.gitkeep
!config/examples/

# Browser automation
playwright-report/
test-results/

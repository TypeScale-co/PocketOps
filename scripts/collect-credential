#!/usr/bin/env python3
"""
Collect a credential from the user via browser prompt.

Usage:
    ./scripts/collect-credential ENV_VAR_NAME "Human-readable label"

Example:
    ./scripts/collect-credential SLACK_BOT_TOKEN "Slack Bot Token"

Opens a browser window with a simple form. User pastes the token,
submits, and the script writes it to .env and exits.
"""

import sys
import os
import socket
import webbrowser
import threading
from pathlib import Path
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qs

# Will be set by main()
ENV_VAR_NAME = ""
LABEL = ""
PROJECT_ROOT: Path = Path.cwd()
server_should_stop = threading.Event()
collected_value: str | None = None


HTML_TEMPLATE = """<!DOCTYPE html>
<html>
<head>
    <title>PocketOps</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #1a1a2e;
            color: #eee;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .container {
            background: #16213e;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            max-width: 500px;
            width: 100%;
        }
        h1 {
            margin: 0 0 8px 0;
            font-size: 24px;
            font-weight: 600;
        }
        .subtitle {
            color: #888;
            margin-bottom: 24px;
            font-size: 14px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        input[type="password"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #333;
            border-radius: 6px;
            background: #0f0f1a;
            color: #eee;
            font-size: 16px;
            margin-bottom: 20px;
        }
        input[type="password"]:focus {
            outline: none;
            border-color: #4a6fa5;
        }
        button {
            width: 100%;
            padding: 12px;
            background: #4a6fa5;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
        }
        button:hover { background: #5a7fb5; }
        .note {
            margin-top: 20px;
            padding: 12px;
            background: #0f0f1a;
            border-radius: 6px;
            font-size: 13px;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Enter {label}</h1>
        <p class="subtitle">This will be saved to a local file on your machine.</p>
        <form method="POST" action="/submit">
            <label for="token">{label}</label>
            <input type="password" id="token" name="token" placeholder="Paste your token here" autofocus required>
            <button type="submit">Save</button>
        </form>
        <div class="note">
            This window can be closed after saving.
        </div>
    </div>
</body>
</html>"""

SUCCESS_HTML = """<!DOCTYPE html>
<html>
<head>
    <title>PocketOps</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #1a1a2e;
            color: #eee;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .container { text-align: center; }
        .check { font-size: 64px; margin-bottom: 20px; }
        h1 { margin: 0; font-weight: 500; }
        p { color: #888; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Saved</h1>
        <p>You can close this window.</p>
    </div>
</body>
</html>"""


class CredentialHandler(BaseHTTPRequestHandler):
    def log_message(self, format: str, *args: object) -> None:
        pass  # Suppress request logging

    def do_GET(self) -> None:
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        html = HTML_TEMPLATE.replace("{label}", LABEL)
        self.wfile.write(html.encode())

    def do_POST(self) -> None:
        global collected_value
        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length).decode()
        params = parse_qs(body)
        token = params.get("token", [""])[0]

        if token:
            collected_value = token
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(SUCCESS_HTML.encode())
            threading.Thread(target=lambda: server_should_stop.set()).start()
        else:
            self.send_response(400)
            self.end_headers()


def find_project_root() -> Path:
    """Find the project root by looking for AGENTS.md."""
    current = Path(__file__).resolve().parent.parent
    if (current / "AGENTS.md").exists():
        return current
    return Path.cwd()


def read_env_file(env_path: Path) -> dict[str, str]:
    """Read existing .env file into a dict."""
    env_vars: dict[str, str] = {}
    if not env_path.exists():
        return env_vars

    with open(env_path, "r") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                key, value = line.split("=", 1)
                env_vars[key.strip()] = value.strip()
    return env_vars


def write_env_file(env_path: Path, env_vars: dict[str, str]) -> None:
    """Write env vars back to .env file."""
    with open(env_path, "w") as f:
        f.write("# PocketOps Credentials\n")
        f.write("# Managed by collect-credential script\n\n")
        for key, value in sorted(env_vars.items()):
            f.write(f"{key}={value}\n")

    os.chmod(env_path, 0o600)


def find_available_port(start: int = 9876, end: int = 9900) -> int:
    """Find an available port."""
    for port in range(start, end):
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.bind(("127.0.0.1", port))
                return port
        except OSError:
            continue
    raise RuntimeError("No available port found")


def main() -> int:
    global ENV_VAR_NAME, LABEL, PROJECT_ROOT

    if len(sys.argv) < 3:
        print("Usage: collect-credential ENV_VAR_NAME \"Label\"", file=sys.stderr)
        print("Example: collect-credential SLACK_BOT_TOKEN \"Slack Bot Token\"", file=sys.stderr)
        return 1

    ENV_VAR_NAME = sys.argv[1]
    LABEL = sys.argv[2]
    PROJECT_ROOT = find_project_root()
    env_path = PROJECT_ROOT / ".env"

    port = find_available_port()
    server = HTTPServer(("127.0.0.1", port), CredentialHandler)
    server.timeout = 0.5

    url = f"http://127.0.0.1:{port}"
    print(f"Opening browser to collect {LABEL}...")
    webbrowser.open(url)

    # Serve until we get a value or timeout (5 minutes)
    import time
    start_time = time.time()
    timeout = 300

    while not server_should_stop.is_set():
        server.handle_request()
        if time.time() - start_time > timeout:
            print("Timeout waiting for credential.", file=sys.stderr)
            return 1

    server.server_close()

    if collected_value:
        env_vars = read_env_file(env_path)
        env_vars[ENV_VAR_NAME] = collected_value
        write_env_file(env_path, env_vars)
        print(f"Saved {ENV_VAR_NAME} to .env")
        return 0
    else:
        print("No credential received.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
